er by more than the noise\"])"," ","-  print(\"\\n== DIFFERENCES (pooled): mean difference ± 95% interval (Welch, 1.96 x standard error) ==\")","-  var pairs := [[\"G\", \"E\", \"the game scene costs more than an empty scene\"],","-      [\"A\", \"G\", \"Effect A's 80 particles cost more than the game alone\"],","-      [\"B\", \"G\", \"Effect B's 48 particles cost more than the game alone\"],","+  print(\"\\n== DIFFERENCES (pooled): mean difference ± 95% interval (Welch, 1.96 x standard error); medians ==\")","+  var pairs := [[\"G\", \"E\", \"the game scene should cost more than an empty scene\"],","+      [\"A\", \"G\", \"Effect A's 80 particles should cost more than the game alone\"],","+      [\"B\", \"G\", \"Effect B's 48 particles should cost more than the game alone\"],","       [\"A\", \"B\", \"A (80 particles) and B (48) are not predicted to cost the same\"]]","   for pr in pairs:","-    for m in [\"process\", \"total\", \"wall\"]:","-      var d := diff(pooled[pr[0]][m], pooled[pr[1]][m])","-      var same: bool = absf(d.delta) <= d.ci","-      print(\"    %s - %s  %-8s %+8.1f ± %5.1f µs  %s\" % [pr[0], pr[1], m, d.delta, d.ci,","-        \"SAME within noise\" if same else \"separated\"])","-      if same and m == \"process\":","-        print(\"    WARNING: %s and %s report the same process time, though %s: the script may be measuring itself, or the difference is below the noise\" % [","-          pr[0], pr[1], pr[2]])","-    if stats(pooled[pr[0]][\"process\"]).mean == stats(pooled[pr[1]][\"process\"]).mean:","-      print(\"    WARNING: %s and %s have identical process means: the monitor may not be updating\" % [pr[0], pr[1]])","+    var d := diff(pooled[pr[0]][\"engine\"], pooled[pr[1]][\"engine\"])","+    var med: float = stats(pooled[pr[0]][\"engine\"]).median - stats(pooled[pr[1]][\"engine\"]).median","+    var same: bool = absf(d.delta) <= d.ci","+    print(\"    %s - %s  engine  mean %+7.1f ± %4.1f µs, median %+7.1f µs  %s\" % [","+      pr[0], pr[1], d.delta, d.ci, med, \"SAME within noise\" if same else \"separated\"])","+    if same:","+      print(\"    WARNING: %s and %s report the same engine time, though %s: the script may be measuring itself, or the difference is below the noise\" % [","+        pr[0], pr[1], pr[2]])","+  for c in CASES:","+    var h := stats(pooled[c][\"harness\"])","+    print(\"    harness share, %s: %.1f µs of %.1f µs wall (%.0f%%)\" % [c, h.mean,","+      stats(pooled[c][\"wall\"]).mean, 100.0 * h.mean / maxf(stats(pooled[c][\"wall\"]).mean, 0.001)])"," "," "," func stats(a: PackedFloat64Array) -> Dictionary:"]},{"oldStart":276,"oldLines":12,"newStart":304,"newLines":6,"lines":["     m, s.n, s.mean, s.sd, s.min, s.median, s.p95, s.max]"," "," ","-func _fixed_fps() -> String:","-  var args := OS.get_cmdline_args()","-  var i := args.find(\"--fixed-fps\")","-  return args[i + 1] if i >= 0 and i + 1 < args.size() else \"off (realtime)\"","-","-"," # --- harness -----------------------------------------------------------------"," "," func check(cond: bool, label: String, msg: String) -> void:"]}],"originalFile":"extends SceneTree\n## A6 step 7: per-frame CPU cost of the two particle effects (CHANGE-BRIEF.md, \"Price predictions\n## and budget\"). Run from the repo root, through the wrapper:\n##   scripts/run-test.sh cost_effects.gd 60 300\n## Source: the course chapter's Example 09 cost script is not in this repository or on this machine,\n## so this script was written from the step's description, not adapted from Example 09's code\n## (Claude Code, under Zhaohui's delegation, 2026-11-08).\n##\n## Cases, each in a fresh scene, with WARMUP frames before MEASURE measured frames:\n##   E  empty      an empty Node2D: what the engine loop and this script's own sampler cost\n##   G  game       main.tscn on its title screen; Effect A's four slots and Effect B not emitting\n##   A  sparks     G + all four HitSpark slots alive at once (4 x 20 = 80 particles, the brief's peak)\n##   B  embers     G + Embers emitting with the field full (48 particles, preprocess + > 2.5 s)\n## The cases run twice, in the order E G A B, then B A G E, so a drift over the run shows up as a\n## difference between the two passes instead of a difference between cases.\n## The game stays on its title screen (phase \"title\") in G, A and B, so no fighter acts, no hit\n## lands and no hitstop starts: the game's own work is the same in the three cases and A - G and\n## B - G are the effects' cost. A running fight is not measured.\n## Writes to game or engine state, each printed:\n##   SETUP  A: each HitSpark slot is given a position in the hit band and restart()ed, staggered\n##          every RETRIGGER frames (< the 36-tick lifetime), so all four bursts are alive on every\n##          measured frame. Done here, not through a hit, because a hit would also start hitstop.\n##   SETUP  B: Embers.restart() (as embers_controller.gd does on entering the fight), so it emits;\n##          the controller leaves emitting alone outside a phase change, and the phase stays \"title\".\n## What is measured, per rendered frame, in microseconds: CPUParticles2D simulates in its internal\n## process notification, so the measure is the engine's own frame time, not this script's code:\n##   process   Performance.TIME_PROCESS (the whole scene tree's process step, internal included)\n##   physics   Performance.TIME_PHYSICS_PROCESS (one 60 Hz tick per frame at --fixed-fps 60)\n##   total     process + physics\n##   wall      wall-clock time between two successive frames (everything, incl. the dummy renderer)\n## The two monitors hold the last completed frame's value, so each sample is read one frame late\n## and the first sample of every case is dropped.\n## A headless run uses the dummy renderer: no particle is drawn, so this is CPU time only.\n\nconst WARMUP := 240                      # 4 s at 60 fps: covers B's 2.5 s lifetime after restart()\nconst MEASURE := 1200                    # 20 s at 60 fps per case and pass\nconst RETRIGGER := 30                    # A: frames between two restarts of one slot (lifetime 36)\nconst SLOT_POINTS := [Vector2(170, 236), Vector2(200, 244), Vector2(230, 240), Vector2(260, 248)]\nconst SLOTS := [\"HitSpark0\", \"HitSpark1\", \"HitSpark2\", \"HitSpark3\"]\nconst METRICS := [\"process\", \"physics\", \"total\", \"wall\"]\nconst CASES := {\"E\": \"empty scene\", \"G\": \"game, both effects off\", \"A\": \"Effect A, 4 bursts alive\",\n\t\t\"B\": \"Effect B, emitting, field full\"}\nconst WALL_LIMIT_MS := 280000            # watchdog, under the wrapper's 300 s\n\nvar checks := 0\nvar failures := 0\nvar finished_run := false\nvar sampler: Sampler\nvar scene: Node\nvar results := {}                        # case -> pass -> metric -> PackedFloat64Array (µs)\n\n\n## Reads the frame monitors once per rendered frame, after every other node's _process.\nclass Sampler extends Node:\n\tvar recording := false\n\tvar samples := {}\n\tvar last_usec := 0\n\tvar started_ms := 0\n\tvar on_watchdog: Callable\n\n\tfunc _ready() -> void:\n\t\tprocess_priority = 1000\n\t\tstarted_ms = Time.get_ticks_msec()\n\n\tfunc begin() -> void:\n\t\tsamples = {}\n\t\tfor m in METRICS:\n\t\t\tsamples[m] = PackedFloat64Array()\n\t\tlast_usec = Time.get_ticks_usec()\n\t\trecording = true\n\n\tfunc _process(_delta: float) -> void:\n\t\tif Time.get_ticks_msec() - started_ms > WALL_LIMIT_MS:\n\t\t\ton_watchdog.call()\n\t\tvar now := Time.get_ticks_usec()\n\t\tif recording:\n\t\t\tvar p := Performance.get_monitor(Performance.TIME_PROCESS) * 1e6\n\t\t\tvar ph := Performance.get_monitor(Performance.TIME_PHYSICS_PROCESS) * 1e6\n\t\t\tsamples[\"process\"].append(p)\n\t\t\tsamples[\"physics\"].append(ph)\n\t\t\tsamples[\"total\"].append(p + ph)\n\t\t\tsamples[\"wall\"].append(float(now - last_usec))\n\t\tlast_usec = now\n\n\nfunc _initialize() -> void:\n\t_run.call_deferred()\n\n\nfunc _run() -> void:\n\tsampler = Sampler.new()\n\tsampler.on_watchdog = _watchdog\n\troot.add_child(sampler)\n\tfor i in 10:\n\t\tawait process_frame\n\tprint(\"cost_effects: Godot %s, %d physics ticks/s, fixed fps %s; headless dummy renderer, CPU time only\" % [\n\t\tEngine.get_version_info().string, ProjectSettings.get_setting(\"physics/common/physics_ticks_per_second\"),\n\t\t_fixed_fps()])\n\tprint(\"Each case: %d warm-up frames, then %d measured frames; two passes (E G A B, then B A G E)\" % [\n\t\tWARMUP, MEASURE])\n\tprint(\"Source: Example 09's script is not available here; written from the step's description.\")\n\tfor c in CASES:\n\t\tresults[c] = {}\n\tvar orders := [[\"E\", \"G\", \"A\", \"B\"], [\"B\", \"A\", \"G\", \"E\"]]\n\tfor p in orders.size():\n\t\tprint(\"\\n== pass %d ==\" % (p + 1))\n\t\tfor c in orders[p]:\n\t\t\tawait run_case(c, p)\n\treport()\n\tfinish()\n\n\n# --- cases -------------------------------------------------------------------\n\nfunc run_case(c: String, pass_i: int) -> void:\n\tprint(\"-- %s: %s\" % [c, CASES[c]])\n\tif c == \"E\":\n\t\tscene = Node2D.new()\n\t\tscene.name = \"Empty\"\n\t\troot.add_child(scene)\n\telse:\n\t\tscene = load(\"res://game/main.tscn\").instantiate()\n\t\troot.add_child(scene)\n\tawait process_frame\n\tvar slots: Array[CPUParticles2D] = []\n\tvar embers: CPUParticles2D = null\n\tif c != \"E\":\n\t\tfor n in SLOTS:\n\t\t\tslots.append(scene.get_node(n) as CPUParticles2D)\n\t\tembers = scene.get_node(\"Embers\") as CPUParticles2D\n\tif c == \"A\":\n\t\tprint(\"    SETUP (not a hit): 4 HitSpark slots positioned in the hit band and restart()ed, each every %d frames, staggered\" % RETRIGGER)\n\tif c == \"B\":\n\t\tembers.restart()\n\t\tprint(\"    SETUP (not a phase change): Embers.restart(), so it emits with preprocess; phase stays \\\"%s\\\"\" % scene.phase)\n\n\tvar bad := []                         # measured frames whose state is not the case's\n\tvar physics_steps := PackedInt32Array()\n\tvar f := 0\n\tvar total_frames := WARMUP + MEASURE + 1\n\twhile f < total_frames:\n\t\tif c == \"A\":\n\t\t\tfor k in slots.size():\n\t\t\t\tif (f + k * (RETRIGGER / 4)) % RETRIGGER == 0:\n\t\t\t\t\tslots[k].position = SLOT_POINTS[k]\n\t\t\t\t\tslots[k].restart()\n\t\tif f == WARMUP:\n\t\t\tsampler.begin()\n\t\tvar ph0 := Engine.get_physics_frames()\n\t\tawait process_frame\n\t\tif f > WARMUP:\n\t\t\tphysics_steps.append(Engine.get_physics_frames() - ph0)\n\t\t\tvar why := _state_error(c, slots, embers)\n\t\t\tif why != \"\":\n\t\t\t\tbad.append(\"frame %d: %s\" % [f - WARMUP, why])\n\t\tf += 1\n\tsampler.recording = false\n\n\tvar data := {}\n\tfor m in METRICS:\n\t\tdata[m] = sampler.samples[m].slice(1)    # first sample belongs to the warm-up's last frame\n\tresults[c][pass_i] = data\n\tcheck(bad.is_empty(), c, \"state held on all %d measured frames%s\" % [\n\t\tdata[\"total\"].size(), \"\" if bad.is_empty() else \" (first: %s; %d bad)\" % [bad[0], bad.size()]])\n\tvar one_tick := physics_steps.count(1) == physics_steps.size()\n\tcheck(one_tick, c, \"exactly one physics tick per measured frame (%d of %d)\" % [\n\t\tphysics_steps.count(1), physics_steps.size()])\n\tif c != \"E\":\n\t\tvar internal := []\n\t\tfor s in slots:\n\t\t\tinternal.append(s.is_processing_internal())\n\t\tprint(\"    OBSERVE: is_processing_internal() at the end: HitSpark0-3 %s, Embers %s\" % [\n\t\t\tinternal, embers.is_processing_internal()])\n\tfor m in METRICS:\n\t\tprint(\"    %s\" % fmt_stats(m, data[m]))\n\tscene.queue_free()\n\tscene = null\n\tawait process_frame\n\tawait process_frame\n\n\n## \"\" when the scene is in the case's state on this frame, else what is wrong.\nfunc _state_error(c: String, slots: Array[CPUParticles2D], embers: CPUParticles2D) -> String:\n\tif c == \"E\":\n\t\treturn \"\"\n\tif scene.phase != \"title\" or scene.paused or scene.hitstop != 0:\n\t\treturn \"phase %s, paused %s, hitstop %d\" % [scene.phase, scene.paused, scene.hitstop]\n\tvar on := 0\n\tfor s in slots:\n\t\tif s.emitting:\n\t\t\ton += 1\n\t\tif s.speed_scale != 1.0:\n\t\t\treturn \"a HitSpark slot has speed_scale %s\" % s.speed_scale\n\tif embers.speed_scale != 1.0:\n\t\treturn \"Embers speed_scale %s\" % embers.speed_scale\n\tvar want_on := 4 if c == \"A\" else 0\n\tif on != want_on:\n\t\treturn \"%d HitSpark slots emitting, expected %d\" % [on, want_on]\n\tif embers.emitting != (c == \"B\"):\n\t\treturn \"Embers emitting %s\" % embers.emitting\n\treturn \"\"\n\n\n# --- report ------------------------------------------------------------------\n\nfunc report() -> void:\n\tprint(\"\\n== SUMMARY: both passes pooled, microseconds per frame ==\")\n\tprint(\"%-34s %-8s %9s %9s %9s %9s %9s %9s\" % [\"case\", \"metric\", \"mean\", \"sd\", \"min\", \"median\", \"p95\", \"max\"])\n\tvar pooled := {}\n\tfor c in CASES:\n\t\tpooled[c] = {}\n\t\tfor m in METRICS:\n\t\t\tvar a := PackedFloat64Array()\n\t\t\tfor p in results[c]:\n\t\t\t\ta.append_array(results[c][p][m])\n\t\t\tpooled[c][m] = a\n\t\t\tvar s := stats(a)\n\t\t\tprint(\"%-34s %-8s %9.1f %9.1f %9.1f %9.1f %9.1f %9.1f\" % [\n\t\t\t\t\"%s %s\" % [c, CASES[c]] if m == METRICS[0] else \"\", m,\n\t\t\t\ts.mean, s.sd, s.min, s.median, s.p95, s.max])\n\n\tprint(\"\\n== DRIFT: pass 1 vs pass 2 (total), difference and its 95% interval ==\")\n\tfor c in CASES:\n\t\tvar d := diff(results[c][1][\"total\"], results[c][0][\"total\"])\n\t\tprint(\"    %s: pass 1 %.1f, pass 2 %.1f, difference %+.1f ± %.1f µs%s\" % [c,\n\t\t\tstats(results[c][0][\"total\"]).mean, stats(results[c][1][\"total\"]).mean, d.delta, d.ci,\n\t\t\t\"\" if absf(d.delta) <= d.ci else \"  <- the passes disagree\"])\n\n\tprint(\"\\n== DIFFERENCES (pooled): mean difference ± 95% interval (Welch, 1.96 x standard error) ==\")\n\tvar pairs := [[\"G\", \"E\", \"the game scene costs more than an empty scene\"],\n\t\t\t[\"A\", \"G\", \"Effect A's 80 particles cost more than the game alone\"],\n\t\t\t[\"B\", \"G\", \"Effect B's 48 particles cost more than the game alone\"],\n\t\t\t[\"A\", \"B\", \"A (80 particles) and B (48) are not predicted to cost the same\"]]\n\tfor pr in pairs:\n\t\tfor m in [\"process\", \"total\", \"wall\"]:\n\t\t\tvar d := diff(pooled[pr[0]][m], pooled[pr[1]][m])\n\t\t\tvar same: bool = absf(d.delta) <= d.ci\n\t\t\tprint(\"    %s - %s  %-8s %+8.1f ± %5.1f µs  %s\" % [pr[0], pr[1], m, d.delta, d.ci,\n\t\t\t\t\"SAME within noise\" if same else \"separated\"])\n\t\t\tif same and m == \"process\":\n\t\t\t\tprint(\"    WARNING: %s and %s report the same process time, though %s: the script may be measuring itself, or the difference is below the noise\" % [\n\t\t\t\t\tpr[0], pr[1], pr[2]])\n\t\tif stats(pooled[pr[0]][\"process\"]).mean == stats(pooled[pr[1]][\"process\"]).mean:\n\t\t\tprint(\"    WARNING: %s and %s have identical process means: the monitor may not be updating\" % [pr[0], pr[1]])\n\n\nfunc stats(a: PackedFloat64Array) -> Dictionary:\n\tvar n := a.size()\n\tif n == 0:\n\t\treturn {\"n\": 0, \"mean\": 0.0, \"sd\": 0.0, \"min\": 0.0, \"median\": 0.0, \"p95\": 0.0, \"max\": 0.0}\n\tvar sum := 0.0\n\tfor v in a:\n\t\tsum += v\n\tvar mean := sum / n\n\tvar sq := 0.0\n\tfor v in a:\n\t\tsq += (v - mean) * (v - mean)\n\tvar sd := sqrt(sq / maxi(n - 1, 1))\n\tvar s := a.duplicate()\n\ts.sort()\n\treturn {\"n\": n, \"mean\": mean, \"sd\": sd, \"min\": s[0], \"median\": s[n / 2],\n\t\t\t\"p95\": s[mini(int(n * 0.95), n - 1)], \"max\": s[n - 1]}\n\n\n## a - b: difference of means and the half-width of its 95% interval.\nfunc diff(a: PackedFloat64Array, b: PackedFloat64Array) -> Dictionary:\n\tvar sa := stats(a)\n\tvar sb := stats(b)\n\tvar se := sqrt(sa.sd * sa.sd / maxi(sa.n, 1) + sb.sd * sb.sd / maxi(sb.n, 1))\n\treturn {\"delta\": sa.mean - sb.mean, \"ci\": 1.96 * se}\n\n\nfunc fmt_stats(m: String, a: PackedFloat64Array) -> String:\n\tvar s := stats(a)\n\treturn \"%-8s n %d  mean %.1f  sd %.1f  min %.1f  median %.1f  p95 %.1f  max %.1f µs\" % [\n\t\tm, s.n, s.mean, s.sd, s.min, s.median, s.p95, s.max]\n\n\nfunc _fixed_fps() -> String:\n\tvar args := OS.get_cmdline_args()\n\tvar i := args.find(\"--fixed-fps\")\n\treturn args[i + 1] if i >= 0 and i + 1 < args.size() else \"off (realtime)\"\n\n\n# --- harness -----------------------------------------------------------------\n\nfunc check(cond: bool, label: String, msg: String) -> void:\n\tchecks += 1\n\tif not cond:\n\t\tfailures += 1\n\tprint(\"    %s [%s] %s\" % [\"PASS\" if cond else \"FAIL\", label, msg])\n\n\nfunc _watchdog() -> void:\n\tif finished_run:\n\t\treturn\n\tcheck(false, \"harness\", \"watchdog: not finished after %d s of wall-clock time\" % (WALL_LIMIT_MS / 1000))\n\tfinish()\n\n\nfunc finish() -> void:\n\tif finished_run:\n\t\treturn\n\tfinished_run = true\n\tprint(\"%d checks, %d failed\" % [checks, failures])\n\tquit(1 if failures else 0)\n","userModified":false},"tool_result_meta":[{"id":"toolu_013avxjQ37grm7zhBQin3wQu","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
